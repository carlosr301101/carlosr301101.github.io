---
interface Props {
	prev?: string
	next?: string
	prevLabel?: string
	nextLabel?: string
}

const { prev, next, prevLabel = 'Recent posts', nextLabel = 'Older Posts' } = Astro.props
---

<div class="flex justify-between">
	{
		prev ? (
			<a href={prev} class="btn btn-ghost mx-5 my-10">
				{' '}
				<svg
					class="h-6 w-6 fill-current md:h-8 md:w-8"
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
				</svg>{' '}
				{prevLabel}
			</a>
		) : (
			<div />
		)
	}
	{
		next ? (
			<a href={next} class="btn btn-ghost mx-5 my-10">
				{nextLabel}{' '}
				<svg
					class="h-6 w-6 fill-current md:h-8 md:w-8"
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					{' '}
					<path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
				</svg>
			</a>
		) : (
			<div />
		)
	}
</div>
